{
  "mcpServers": {
    "azure": {
      "command": "npx",
      "args": ["-y", "@azure/mcp@latest", "server", "start"]
    },
    "azure-devops": {
      "command": "sh",
      "args": [
        "-c",
        "npx -y @azure-devops/mcp@latest \"$AZ_ORGANIZATION_NAME\""
      ]
    },
    "gitnexus": {
      "command": "gitnexus",
      "args": ["mcp"]
    },
    "structurizr": {
      "command": "npx",
      "args": ["-y", "mcp-remote", "http://localhost:3000/mcp"]
    }
  }
}
