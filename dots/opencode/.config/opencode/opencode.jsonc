{
  "$schema": "https://opencode.ai/config.json",
  "lsp": true,
  "compaction": {
    "auto": true,
    "prune": true
  },
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama",
      "options": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "collab_partner:latest": {
          "name": "collab_partner:latest",
          "contextWindow": 131072
        },
        "debugger:latest": {
          "name": "debugger:latest",
          "contextWindow": 65536
        },
        "drift_auditor:latest": {
          "name": "drift_auditor:latest",
          "contextWindow": 131072
        },
        "spec_auditor:latest": {
          "name": "spec_auditor:latest",
          "contextWindow": 131072
        },
        "ornith_test:latest": {
          "name": "ornith_test:latest",
          "contextWindow": 131072
        }
      }
    }
  },
  "permission": {
    "*": "ask",
    "read": {
      "**/*": "allow",
      "**/.*": "ask",
      "**/.*/**": "ask"
    },
    "edit": {
      "src/**": "allow",
      "test/**": "allow",
      "tests/**": "allow",
      "docs/**": "allow",
      "*.md": "allow",
      "*": "ask"
    },
    "bash": {
      "npm test": "allow",
      "npm run *": "allow",
      "cargo *": "allow",
      "make *": "allow",
      "git *": "allow",
      "find *": "allow",
      "head *": "allow",
      "tail *": "allow",
      "ls *": "allow",
      "*": "ask"
    }
  },
  "mcp": {
    "azure": {
      "type": "local",
      "enabled": false,
      "command": ["npx","-y", "@azure/mcp@latest", "server", "start"]
    },
    "azure-devops": {
      "type": "local",
      "enabled": false,
      "command": ["npx", "-y", "@azure-devops/mcp@latest", "{env:AZ_ORGANIZATION_NAME}"]
    }
  }
}
